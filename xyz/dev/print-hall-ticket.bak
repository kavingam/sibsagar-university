$roomObj = new Room();
$rooms = $roomObj->getAllRooms();

// Flatten all zigzag_students
$students = [];
foreach ($allData as $block) {
    $students = array_merge($students, $block['zigzag_students']);
}

$assignedRooms = allocateStudentsToRooms($rooms, count($students));

// Academic Info
$academicYear = date('Y');
$examName = "Semester Exam";
$examDate = date('d-m-Y');
$examTime = "10:00 AM - 1:00 PM";
$examTime24 = "10:00";
$saveData = 0;
