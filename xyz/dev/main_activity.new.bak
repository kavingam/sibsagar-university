function getZigzagMergedStudentsPerBlock($data) {
    $result = [];

    foreach ($data as $block) {
        $blockId = $block['_id'] ?? null;
        $subjectGroups = [];

        // STEP 1: Handle nested structure
        if (isset($block[0]) && is_array($block[0]) && isset($block[0][0]['students'])) {
            // Case: $block[0] contains an array of subject groups
            foreach ($block[0] as $group) {
                if (isset($group['students']) && is_array($group['students'])) {
                    $subjectGroups[] = array_values($group['students']);
                }
            }
        } else {
            // Case: $block is a single-level subject group array
            foreach ($block as $key => $group) {
                if ($key === '_id' || !is_array($group)) continue;
                if (isset($group['students']) && is_array($group['students'])) {
                    $subjectGroups[] = array_values($group['students']);
                }
            }
        }

        // Zigzag logic
        $zigzag = [];
        $seenRollNos = [];

        $maxLength = 0;
        $totalSubjectGroups = count($subjectGroups);

        foreach ($subjectGroups as $group) {
            $maxLength = max($maxLength, count($group));
        }

        // echo "<strong>Block ID: {$blockId}</strong><br>";
        // echo "Total Subject Groups: $totalSubjectGroups<br>";
        // echo "Maximum Group Length: $maxLength<br>";

        for ($i = 0; $i < $maxLength; $i++) {
            for ($j = 0; $j < $totalSubjectGroups; $j++) {
                if (isset($subjectGroups[$j][$i])) {
                    $student = $subjectGroups[$j][$i];
                    $rollNo = $student['roll_no'] ?? null;
                    if ($rollNo && !in_array($rollNo, $seenRollNos)) {
                        $zigzag[] = $student;
                        $seenRollNos[] = $rollNo;
                    }
                }
            }
        }

        // Optional: Display result
        // foreach ($zigzag as $s) {
        //     echo $s['roll_no'] . ' - ' . $s['name'] . '<br>';
        // }

        $result[] = [
            'block_id' => $blockId,
            'zigzag_students' => $zigzag
        ];
    }

    return $result;
}



