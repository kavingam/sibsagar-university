//             unset($student['_id']);
//         }
//     }

//     return $selectedDepartments;
// }
function selectDepartmentsXv(array $departments, int $n): array {
    // Check if $n is within bounds of the departments array
    if ($n <= 0 || $n > count($departments)) {
        // Return an empty array or handle as needed
        return [];  // or throw an exception, depending on your preference
    }

    // Step 1: Select the first $n departments
    $selectedDepartments = array_slice($departments, 0, $n);

    // Step 2: Use totalStudent of the last selected department as the remainder
    $remainder = $selectedDepartments[$n - 1]['totalStudent'];

    // Step 3: Process each department
    foreach ($selectedDepartments as &$dept) {
        // Remove _id if it exists
        unset($dept['_id']);

        // If remainder matches the totalStudent of this department, set totalStudent to 0
        if ($dept['totalStudent'] == $remainder) {
            $dept['students'] = [];  // No students to keep
            $dept['totalStudent'] = 0;  // Set totalStudent to 0
        } else {
            // Calculate how many students to keep
            $countToKeep = max($dept['totalStudent'] - $remainder, 0);

            // Slice students and update totalStudent
            $dept['students'] = array_slice($dept['students'], -$countToKeep, null, true);
            $dept['totalStudent'] = count($dept['students']);
        }

        // Optionally remove _id from each student (uncomment if needed)
        foreach ($dept['students'] as &$student) {
            unset($student['_id']);
        }
    }

    return $selectedDepartments;
}



